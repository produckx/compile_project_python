{
  "exclude_dirs": [
    "venv",
    ".git",
    ".ai",
    ".cline",
    ".github",
    ".opencode",
    ".vscode",
    ".playwright-mcp",
    "__pycache__",
    "build",
    "dist",
    "node_modules",
    "alembic",
    "migrations"
  ],
  "exclude_files": [
    "setup.py",
    "main.py"
  ],
  "exclude_extensions": [
    "*.pyc",
    "*.pyo",
    "*.c",
    "*.cpp",
    "*.obj"
  ],
  "keep_files": [
    "main.py",
    "main_obf.py"
  ],
  "keep_folders": [
    "static/swagger-ui"
  ],
  "obfuscate_web": true
}